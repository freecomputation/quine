; classics.tq - the fixed-point classics, runnable with
;   tarraq run examples/classics.tq
; (the last form in the file is its value)

(define (fact n)
  (if (= n 0)
      1
      (* n (fact (- n 1)))))

(define (fib n)
  (if (< n 2)
      n
      (+ (fib (- n 1)) (fib (- n 2)))))

; the sage bird: recursion with no name bound anywhere,
; the fixed point taken in the hand
(define y-fact
  ((lambda (f)
     (f f))
   (lambda (self)
     (lambda (n)
       (if (= n 0)
           1
           (* n ((self self) (- n 1))))))))

; a counter: state held in a closure, changed by set!
(define (make-counter)
  (define count 0)
  (lambda ()
    (set! count (+ count 1))
    count))

(define counter (make-counter))

; mutual recursion, the board's home ground
(define (even n)
  (if (= n 0) #t (odd (- n 1))))

(define (odd n)
  (if (= n 0) #f (even (- n 1))))

; the file's value: a small census of known answers -
; (fact 5) is 120, (fib 10) is 55, (y-fact 5) is 120,
; three counts are 1 2 3, (even 10) is #t
(list (fact 5)
      (fib 10)
      (y-fact 5)
      (counter)
      (counter)
      (counter)
      (even 10))
